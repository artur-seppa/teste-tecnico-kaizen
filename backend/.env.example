PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura do JWT. Gere com: npm run segredo:gerar
JWT_SEGREDO=troque-por-um-segredo-aleatorio
JWT_EXPIRACAO=7d

# Banco proprio do e-commerce (usuarios, enderecos, carrinho).
# Catalogo e pedidos NAO ficam aqui: vem do ERP.
DB_PATH=./data/ecommerce.db

# --- Integracao com o Kaizen ERP -------------------------------------------
# ATENCAO AO NOME. As credenciais sao enviadas por e-mail como SIAC_URL e
# SIAC_TOKEN, e o README tambem fala em SIAC_URL - mas o codigo le ERP_URL e
# ERP_TOKEN. Copie os VALORES do e-mail para as chaves abaixo; se definir
# SIAC_URL no .env, a aplicacao nao vai enxergar.
#
# Sao credenciais e nao ficam no repositorio. Na falta delas, peca ao
# responsavel pelo teste. Para conferir se o endereco responde, o ERP atende
# GET <ERP_URL>/health sem exigir token.
#
# ERP_URL e a BASE da API - os caminhos (/produtos, /pedidos) sao montados em
# cima dela.
ERP_URL=cole-aqui-a-URL-do-kaizen-erp
ERP_TOKEN=cole-aqui-o-API_TOKEN-do-kaizen-erp
ERP_TIMEOUT_MS=8000

# Origem do front em desenvolvimento (Vite). Em producao o backend serve o
# build do front e esta variavel deixa de importar.
CORS_ORIGEM=http://localhost:5173
