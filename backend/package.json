{
  "name": "kaizen-ecommerce-backend",
  "version": "1.0.0",
  "description": "BFF do e-commerce de autopecas - consome a API do Kaizen ERP",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/init-db.js --reset",
    "segredo:gerar": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('hex'))\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.3"
  }
}
